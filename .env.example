# Supabase — provided automatically by the Vercel Supabase integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role — server-side only, never expose to the client
# Used only in /api/auth/delete-account route
SUPABASE_SERVICE_ROLE_KEY=

# Application URL — used for email redirect links and OAuth callbacks
# In development, defaults to http://localhost:3000 if not set
# In production, must be set to your deployed domain
NEXT_PUBLIC_APP_URL=

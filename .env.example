# Supabase — provided automatically by the Vercel Supabase integration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service role — server-side only, never expose to the client
# Used only in /api/auth/delete-account route
SUPABASE_SERVICE_ROLE_KEY=

# Site URL — used for email redirect links in production
# Leave blank in development; NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL is used instead
NEXT_PUBLIC_SITE_URL=

# Development email redirect override — set by the v0 integration automatically
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
